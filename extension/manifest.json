{
  "manifest_version": 3,
  "name": "Angel Agent Blog Assistant",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "현재 네이버 글쓰기 화면에 제목과 본문, 작업 사진을 V3 Block 순서로 입력합니다. 최종 발행은 사용자가 직접 합니다.",
  "permissions": ["sidePanel", "storage", "activeTab", "webNavigation", "debugger"],
  "host_permissions": ["https://*.naver.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Angel Agent 열기" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "content_scripts": [{ "matches": ["https://*.naver.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }]
}
